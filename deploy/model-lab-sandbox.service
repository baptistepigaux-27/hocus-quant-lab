[Unit]
Description=Hocus Quant SPEC-008 Model Lab sandbox
After=network.target

[Service]
Type=simple
User=hocus-quant-lab
Group=hocus-quant-lab
WorkingDirectory=__ROOT__
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/hocus-quant-model-lab
Environment=OMP_NUM_THREADS=4
Environment=HOCUS_MODEL_LAB_DATA=__ROOT__/data/analysis/spec008-model-lab
Environment=HOCUS_MODEL_LAB_ALL_DATA=__ROOT__/data/analysis/spec008-model-lab-all-features
Environment=HOCUS_INDEX_MODEL_LAB_DATA=__ROOT__/data/analysis/spec008-index-model-lab
Environment=HOCUS_INDEX_SERIES_DATA=__ROOT__/data/analysis/index-series-models-v1
Environment=HOCUS_SBF120_REGIMES_DATA=__ROOT__/data/analysis/sbf120-kmeans7-v1
Environment=HOCUS_SRD_CONTEXT_DATA=__ROOT__/data/analysis/srd-context-v1
Environment=HOCUS_SRD_VAD_DATA=__ROOT__/data/analysis/srd-portfolio-extensions-v1
Environment=HOCUS_SRD_SHORT_DATA=__ROOT__/data/analysis/srd-short-horizons-v1
Environment=HOCUS_SRD_COMMON_DATA=__ROOT__/data/analysis/srd-horizon-common-replay-v1
ExecStart=__ROOT__/.venv/bin/marimo run notebooks/model_lab.py --host 127.0.0.1 --port 8069 --headless --no-token --no-sandbox --base-url /quant-model-lab
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=__ROOT__/.venv
BindReadOnlyPaths=__ROOT__/src
BindReadOnlyPaths=__ROOT__/notebooks
BindReadOnlyPaths=__ROOT__/data/analysis/spec008-model-lab
BindReadOnlyPaths=__ROOT__/data/analysis/spec008-model-lab-all-features
BindReadOnlyPaths=__ROOT__/data/analysis/spec008-index-model-lab
BindReadOnlyPaths=__ROOT__/data/analysis/index-series-models-v1
BindReadOnlyPaths=__ROOT__/data/analysis/sbf120-kmeans7-v1
BindReadOnlyPaths=__ROOT__/data/analysis/srd-context-v1
BindReadOnlyPaths=__ROOT__/data/analysis/srd-portfolio-extensions-v1
BindReadOnlyPaths=__ROOT__/data/analysis/srd-short-horizons-v1
BindReadOnlyPaths=__ROOT__/data/analysis/srd-horizon-common-replay-v1
StateDirectory=hocus-quant-model-lab
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
